{
 "uid": "codeorigin-overview",
 "title": "CodeOrigin overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests / s by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(codeorigin_requests_total[1m]))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "5xx rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(codeorigin_requests_total{status=~\"5..\"}[5m]))",
     "legendFormat": "5xx"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "p95 latency by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le,route) (rate(codeorigin_request_seconds_bucket[5m])))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Guardrail triggers",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (guardrail,action) (rate(codeorigin_guardrail_triggers_total[5m]))",
     "legendFormat": "{{guardrail}} {{action}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "LLM tokens",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (direction,mode) (rate(codeorigin_llm_tokens_total[5m]))",
     "legendFormat": "{{direction}} {{mode}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Refusals by type",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type) (rate(codeorigin_refusals_total[5m]))",
     "legendFormat": "{{type}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "logs",
   "title": "Service logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{container=~\"codeorigin-.*\"}"
    }
   ]
  },
  {
   "id": 20,
   "type": "row",
   "title": "Evaluation results (dev/test runs; automatic key-fact scoring; not human-graded)",
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 21,
   "type": "gauge",
   "title": "Run progress",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 4,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "codeorigin_eval_run_progress{run=\"$run\"}",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "showThresholdMarkers": false
   }
  },
  {
   "id": 22,
   "type": "barchart",
   "title": "Overall correctness by model and mode",
   "description": "Mean key-fact correctness over all categories; see the category panels, there is no single headline score.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 35,
    "w": 10,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "codeorigin_eval_correctness_overall{run=\"$run\",model=~\"$model\"}",
     "legendFormat": "{{model}} / {{mode}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false
    }
   ]
  },
  {
   "id": 23,
   "type": "barchart",
   "title": "History effect: code_history minus code_only (history categories)",
   "description": "Pre-registered rule: useful only if >= 0.10 with a 95% CI above 0 and control loss <= 0.05. See the verdict table.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 14,
    "y": 35,
    "w": 10,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "codeorigin_eval_history_effect{run=\"$run\",bound=\"mean\"}",
     "legendFormat": "{{model}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false
    }
   ]
  },
  {
   "id": 24,
   "type": "table",
   "title": "Verdict (pre-registered rule)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 41,
    "w": 4,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "codeorigin_eval_verdict{run=\"$run\"} == 1",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "run": true
      }
     }
    }
   ]
  },
  {
   "id": 25,
   "type": "barchart",
   "title": "Correctness by category",
   "description": "Per-category means; n per category is small on the demo dataset, so read with the confidence intervals in the report.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 47,
    "w": 14,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "codeorigin_eval_correctness{run=\"$run\",model=~\"$model\"}",
     "legendFormat": "{{model}} / {{mode}} / {{category}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false
    }
   ]
  },
  {
   "id": 26,
   "type": "barchart",
   "title": "Failure taxonomy (answers)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 14,
    "y": 43,
    "w": 10,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model, failure) (codeorigin_eval_failures{run=\"$run\",model=~\"$model\"})",
     "legendFormat": "{{model}} / {{failure}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false
    }
   ]
  },
  {
   "id": 27,
   "type": "barchart",
   "title": "LLM jury correctness (answers it graded)",
   "description": "Jury is not validated against humans yet (needs graded answers; see docs/OWN_REPO_TEST.md).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 14,
    "y": 52,
    "w": 10,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "codeorigin_eval_jury_correctness{run=\"$run\",model=~\"$model\"}",
     "legendFormat": "{{model}} / {{mode}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false
    }
   ]
  }
 ],
 "templating": {
  "list": [
   {
    "name": "run",
    "label": "Eval run",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(codeorigin_eval_run_progress, run)",
     "refId": "r"
    },
    "refresh": 2,
    "sort": 4,
    "current": {},
    "includeAll": false
   },
   {
    "name": "model",
    "label": "Model",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(codeorigin_eval_correctness_overall{run=\"$run\"}, model)",
     "refId": "m"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {}
   }
  ]
 }
}