# Copy to .env (git-ignored). Never commit real secrets.
TAG=dev

# --- exposed ports ---
GATEWAY_PORT=8200
WEB_PORT=5180
CHROMA_PORT=8206

# --- LLM (Ollama) ---
# Default: the Ollama running on the host (reuses your downloaded models + GPU).
OLLAMA_HOST=http://host.docker.internal:11434
# Containerised Ollama instead: `--profile ollama`, then
# OLLAMA_HOST=http://codeorigin-ollama:11434   and point at your model folder:
# OLLAMA_MODELS_DIR=C:/Users/ASUS/.ollama
MOCK_LLM=0
# Context window sent to Ollama (0 = Ollama default 4096). 3072 fits llama2-7B on a 6 GB GPU when the host Ollama runs with
# OLLAMA_FLASH_ATTENTION=1 and OLLAMA_KV_CACHE_TYPE=q8_0 (see docs/OPERATIONS.md). Keep it identical across modes.
OLLAMA_NUM_CTX=3072
LLM_MODEL=llama2
JUDGE_MODEL=gemma:2b
LLM_TIMEOUT_SECONDS=300

# --- retrieval ---
EMBEDDING_BACKEND=sentence
EMBEDDING_MODEL=all-MiniLM-L6-v2
STORE_BACKEND=chroma

# --- guardrail thresholds: calibrated 2026-10-04 for sentence/all-MiniLM-L6-v2 on the dev split (hash embedder needs 0.25/0.30) ---
OFF_TOPIC_MIN_RELEVANCE=0.36
HISTORY_MIN_RELEVANCE=0.44
GROUNDING_MIN_SUPPORT=0.50
CONTEXT_CHAR_BUDGET=6000

# --- security ---
# API_KEY is required by the prod override; empty = open (local dev only)
API_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
ALLOW_LOCAL_REPOS=0

# --- ingestion caps ---
MAX_COMMITS=2000
MAX_ISSUES=300
MAX_PRS=200

# --- monitoring overlay ---
GRAFANA_ADMIN_PASSWORD=change-me
# Anonymous read-only dashboard viewing (local convenience). Set false on any shared machine.
GRAFANA_ANONYMOUS_VIEWER=true
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# --- prod override ---
GHCR_OWNER=your-org
