      "category": "design_rationale",
      "split": "dev",
      "question": "Why was session-cookie authentication replaced with JWT tokens?",
      "expect": "answer",
      "gold_answer": "Session fixation allowed account takeover, so authentication moved to signed JWT access tokens.",
